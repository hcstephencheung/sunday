# Copy to .env (never commit .env). Values here are placeholders only.

# dev runs docker-compose.dev.yml on the host; prod runs docker-compose.prod.yml.
ENV=dev

# Local HTTPS port for the dev stack, bound to 127.0.0.1 only. Empty means 8443,
# i.e. https://sunday.localhost:8443
SUNDAY_HTTPS_PORT=

# --- Remote access over Tailscale (dev only, see "Remote access" in README.md) ---
# One-time auth key from the Tailscale admin console (Settings -> Keys):
# not reusable, not ephemeral, pre-approved if offered, no tags.
# Leave empty to run without the tailscale container.
TS_AUTHKEY=
# Device name on the tailnet. Empty means "sunday".
TS_HOSTNAME=
# Full MagicDNS name the app answers to, e.g. sunday.<tailnet>.ts.net
TAILNET_HOST=
